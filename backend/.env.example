PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/remogen_studio
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
TTS_BASE_URL=http://localhost:7851
TTS_SPEED_FACTOR=0.88
ALLTALK_VOICES_DIR=
ALLTALK_DEFAULT_VOICE=female_01.wav
TTS_LANGUAGE=en

# Which voice engine to use by default (a signed-in user's saved Voice Engine
# settings, if any, override this): "auto" | "colab" | "local"
TTS_PROVIDER=auto
# Optional fallback if a user hasn't saved their own Colab settings yet.
COLAB_TTS_URL=
COLAB_TTS_API_KEY=

STORAGE_ROOT=public/storage
# How Remotion's headless renderer reaches this server to fetch narration
# clips - must be reachable from THIS machine, since rendering always
# happens locally regardless of which TTS engine generated the audio.
BACKEND_PUBLIC_URL=http://localhost:4000
RENDER_CONCURRENCY=1

CLIENT_ORIGIN=http://localhost:5173
